# AI provider order: auto = Gemini (free tier) -> Claude -> extractive fallback. Or: gemini | claude | extractive
AI_PROVIDER=auto
# Google Gemini API key (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Min gap between Gemini calls in ms (7000 = ~8 requests/min, under free-tier RPM)
GEMINI_MIN_GAP_MS=7000
# Older fallback-summarised posts re-summarised with AI per run
AI_BACKFILL_PER_RUN=3
# Claude (Anthropic) API key. Optional: without it (or without credit) the app uses the built-in extractive summariser.
ANTHROPIC_API_KEY=
# Claude model id (cheap + fast recommended)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Secret for signing login sessions (any long random string). Auto-generated into data/ if empty.
AUTH_SECRET=
# Bearer token required by /api/cron (used by GitHub Actions / external schedulers)
CRON_SECRET=change-me
# In-app scheduler: interval in minutes (0 disables; use external cron instead)
FETCH_INTERVAL_MINUTES=5
# Max new stories summarised + framed per run (controls AI cost)
MAX_ITEMS_PER_RUN=10
# Where SQLite DB, rendered frames and media cache live
DATA_DIR=./data
PORT=3000
